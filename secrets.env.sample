# Copy to secrets.env and fill in. secrets.env is gitignored.
# Quote values with single quotes if they contain spaces or shell characters.
# Do not put inline comments on a value line.

# Enlighten account. Same login as https://enlighten.enphaseenergy.com/
# Used both to mint the local gateway token and to download cloud history.
ENPHASE_EMAIL='you@example.com'
ENPHASE_PASSWORD='change-me'

# Local IQ Gateway / Envoy. production.json on firmware 7+ needs the token,
# not these digest passwords.
ENVOY_HOST='192.168.1.10'
ENVOY_SERIAL='000000000000'

# Enlighten site id from the system URL, and the user id from the API screen.
ENLIGHTEN_SYSTEM_ID='0000000'
ENLIGHTEN_USER_ID=''

# Legacy digest logins from before firmware 7. envoy's password was the last
# six digits of the serial. installer's password came from the Enphase
# Installer Toolkit. D8 does not accept them for production.json.
ENVOY_INSTALLER_USER='installer'
ENVOY_INSTALLER_PASSWORD=''
ENVOY_USER='envoy'
ENVOY_PASSWORD=''

# Where JSONL samples and the Enlighten archive are written.
DATA_DIR='data'

# Refresh the local JWT this many days before it expires.
# A homeowner token lasts about a year. An installer token lasts about 12 hours.
TOKEN_REFRESH_DAYS='14'

# Seconds between local production samples.
SAMPLE_SECONDS='30'
